        "date": {
          "type": "string",
          "label": "調査日"
        },
        "roomOnly": {
          "type": "string",
          "label": "1R"
        },
        "withKitchen": {
          "type": "string",
          "label": "1K"
        },
        "source": {
          "type": "string",
          "label": "出典"
        }
      }
    },
    "lastTrainDepartTime": {
      "type": "string",
      "label": "終電：新宿発時刻"
    },
