      "type": "string",
      "label": "タクシー代：調査時点"
    },
    "taxiFareStatus": {
      "type": "enum",
      "label": "タクシー代：確定/推定",
      "values": [
        "✅ 確定",
        "⚠️ 推定"
      ]
    },
    "wardSafetyLevel": {
      "type": "enum",
      "label": "治安：区の水準（23区内での相対位置）",
