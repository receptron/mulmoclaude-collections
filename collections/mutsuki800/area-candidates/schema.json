{
  "title": "エリア候補",
  "icon": "location_city",
  "dataPath": "data/area-candidates/items",
  "primaryKey": "id",
  "fields": {
    "id": {
      "type": "string",
      "label": "ID",
      "primary": true
    },
    "wardName": {
      "type": "string",
      "label": "区名"
    },
    "stationName": {
      "type": "string",
      "label": "最寄り駅名"
    },
    "lines": {
      "type": "string",
      "label": "使える路線（複数、読点区切り）"
    },
    "commuteMinutes": {
      "type": "number",
      "label": "勤務先までの所要時間（分）"
    },
    "transfers": {
      "type": "number",
      "label": "乗り換え回数"
    },
    "rentRoomOnly": {
      "type": "string",
      "label": "1R家賃（万円、幅可、最新値）"
    },
    "rentWithKitchen": {
      "type": "string",
      "label": "1K家賃（万円、幅可、最新値）"
    },
    "rentSource": {
      "type": "string",
      "label": "家賃：出典（最新）"
    },
    "rentSurveyDate": {
      "type": "string",
      "label": "家賃：調査時点（最新）"
    },
    "rentStatus": {
      "type": "enum",
      "label": "家賃：確定/推定（最新）",
