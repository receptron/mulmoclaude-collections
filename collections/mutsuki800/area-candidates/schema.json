    "goodReputation": {
      "type": "text",
      "label": "街の良い評判"
    },
    "complaints": {
      "type": "text",
      "label": "街の不満点"
    },
    "morningNote": {
      "type": "text",
      "label": "朝の様子（メモ）"
    },
    "morningPhoto": {
      "type": "image",
      "label": "朝の写真"
    },
    "noonNote": {
      "type": "text",
      "label": "昼の様子（メモ）"
    },
    "noonPhoto": {
      "type": "image",
      "label": "昼の写真"
    },
    "nightNote": {
      "type": "text",
      "label": "夜の様子（メモ）"
    },
    "nightPhoto": {
      "type": "image",
      "label": "夜の写真"
    },
    "midnightNote": {
      "type": "text",
      "label": "深夜の様子（メモ）"
    },
    "midnightPhoto": {
      "type": "image",
      "label": "深夜の写真"
    },
    "notes": {
      "type": "text",
      "label": "総合メモ"
